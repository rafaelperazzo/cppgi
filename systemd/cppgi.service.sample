[Unit]
Description=Sistema Flask Yoko-Eventos
After=network.target mariadb.service
Requires=mariadb.service

[Service]
User=admin
Group=www-data
WorkingDirectory=/home/admin/cppgi/flask
Environment=GIT_PYTHON_REFRESH=quiet
Environment="PATH=/home/admin/moduloPesquisaPRPI/app/env/bin:/usr/bin:/usr/local/bin"
PRODUCAO=1 faz pesquisa.py carregar a config do AWS SSM Parameter Store (prefixo /cppgi)
# em vez de flask/.env - requer credenciais AWS no host (ver CLAUDE.md).
Environment="PRODUCAO=1"
ExecStart=/home/admin/moduloPesquisaPRPI/app/env/bin/python /home/admin/cppgi/flask/pesquisa.py
Restart=on-failure
RestartSec=5
# VPS de 1GB total, com MariaDB na mesma máquina. Uso real medido via
# `systemctl status cppgi`: Memory 90.7M (peak 90.9M) em operação normal.
# MemoryHigh = limite "suave": acima disso o cgroup passa a reclamar
# memória agressivamente e desacelerar o processo, mas NÃO mata.
# MemoryMax  = limite "duro": só mata o processo se ultrapassar isso
# (ex: vazamento real fugindo do controle). Restart=on-failure religa.
# Valores com ~2.7-3.3x de margem sobre o pico observado, deixando o
# grosso do 1GB livre pro MariaDB e o SO. Reavaliar se o pico real subir.
MemoryHigh=250M
MemoryMax=300M

[Install]
WantedBy=multi-user.target
