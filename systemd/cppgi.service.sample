[Unit]
Description=Sistema Flask Yoko-Eventos
After=network.target mariadb.service pesquisa.service
Requires=mariadb.service pesquisa.service

[Service]
User=pesquisa
UMask=0007
WorkingDirectory=/opt/cppgi/flask
Environment=GIT_PYTHON_REFRESH=quiet
Environment="PATH=/home/admin/moduloPesquisaPRPI/app/env/bin:/usr/bin:/usr/local/bin"
# PRODUCAO=1 faz pesquisa.py carregar a config do AWS SSM Parameter Store (prefixo /cppgi)
# em vez de flask/.env - requer credenciais AWS no host (ver CLAUDE.md).
Environment="PRODUCAO=1"
ExecStart=/home/admin/moduloPesquisaPRPI/app/env/bin/python /opt/cppgi/flask/pesquisa.py
Restart=on-failure
RestartSec=5

# Gerenciamento de memória
# VPS de 1GB total, com MariaDB na mesma máquina. Uso real medido via
# `systemctl status cppgi`: Memory 90.7M (peak 90.9M) em operação normal.
# MemoryHigh = limite "suave": acima disso o cgroup passa a reclamar
# memória agressivamente e desacelerar o processo, mas NÃO mata.
# MemoryMax  = limite "duro": só mata o processo se ultrapassar isso
# (ex: vazamento real fugindo do controle). Restart=on-failure religa.
# Valores com ~2.7-3.3x de margem sobre o pico observado, deixando o
# grosso do 1GB livre pro MariaDB e o SO. Reavaliar se o pico real subir.
MemoryHigh=250M
MemoryMax=300M

# Diretivas de isolamento e segurança
# ProtectSystem=strict + ProtectHome=read-only tornam todo o sistema (e /home)
# somente leitura por padrão; ReadWritePaths abre exceções pontuais, restritas
# às pastas/arquivos que pesquisa.py de fato grava em runtime (uploads de
# anexos, PDFs de declaração/resultado, certificados gerados, templates de
# certificado enviados pelo admin, e os dois arquivos de log) - o resto da
# árvore do repo (código, venv em moduloPesquisaPRPI, etc.) fica só leitura.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/cppgi/flask/uploads /opt/cppgi/flask/pdfs /opt/cppgi/flask/certificados /opt/cppgi/flask/documentos -/opt/cppgi/flask/app.log -/opt/cppgi/flask/auditoria.log /tmp /var/tmp
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
