version: '3.8'

services:
  db_cppgi:
     image: mariadb:10.5.8
     restart: always
     command: mysqld --sql_mode=""
     environment:
       MYSQL_ROOT_PASSWORD: SENHA
       MYSQL_DATABASE: cppgi
       MYSQL_USER: cppgi
       MYSQL_PASSWORD: SENHA
       TZ: America/Fortaleza
     volumes:
       - ./mysql:/var/lib/mysql
       - ./share:/share
     networks:
       - web  

  cppgi:
    image: cppgi:py3
    build: .
    volumes:
      - ./flask:/home/perazzo/cppgi
      - ./fonts:/fonts
    restart: always
    ports:
      - "9010:80"
    networks:
      - web

networks:
  web:
    external: true
