services:
  db_cppgi:
     # Uso local/dev apenas - em produção o MariaDB roda nativamente no host via systemd
     # (mariadb.service), não neste container. Ver systemd/*.sample para a criptografia at-rest
     # (chave via AWS SSM) usada em produção.
     image: mariadb:11
     restart: no
     command: mariadbd --sql_mode=""
     environment:
       # ${MYSQL_ROOT_PASSWORD}/${MYSQL_PASSWORD} vêm de um .env na raiz do repo (convenção nativa do
       # docker-compose, ver https://docs.docker.com/compose/environment-variables/) - crie um localmente,
       # não é gerado por nenhuma ferramenta externa.
       MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
       MYSQL_DATABASE: cppgi
       MYSQL_USER: cppgi
       MYSQL_PASSWORD: ${MYSQL_PASSWORD}
       TZ: America/Fortaleza
     #ports:
     #  - "33306:3306"
     volumes:
       - mariadb-cppgi:/var/lib/mysql
       - ./share:/share
     networks:
       - web

  cppgi:
    # Só para dev local - em produção este serviço não roda via docker-compose, e sim nativamente via
    # systemd (systemd/cppgi.service.sample, que é onde PRODUCAO=1 é setado de verdade). Não descomente
    # PRODUCAO=1 aqui: faria o dev local tentar buscar config no AWS SSM em vez de flask/.env.
    image: cppgi:latest
    build: .
    volumes:
      - ./flask:/home/perazzo/cppgi
      - ./fonts:/fonts
    restart: no
    ports:
      - "9010:80"
    networks:
      - web

networks:
  web:
    external: true

volumes:
  mariadb-cppgi: